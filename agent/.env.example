# LLM Provider Configuration
# Options: "openai" or "google_genai"
LLM_PROVIDER=openai

# OpenAI API Key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (required if LLM_PROVIDER=google_genai)
GOOGLE_API_KEY=your_gemini_api_key_here

# Metasploit RPC Configuration
MSF_PASSWORD=your_msfrpc_password
MSF_SERVER=127.0.0.1
MSF_PORT=55553
MSF_SSL=true