# Configuration for Security Vulnerability Analysis Tool

# API Keys
# You can also set these as environment variables:
# - GEMINI_API_KEY
# - NVD_API_KEY
gemini_api_key: ""  # Your Google Gemini API key
nvd_api_key: ""     # Optional: NVD API key for faster queries (10 req/min without key)

# Mitigation Generation Settings
mitigation:
  model: "gemini-2.5-flash"  # Gemini model to use
  max_tokens: 500            # Maximum tokens for response
  temperature: 0.3           # Lower temperature for more focused responses

# Validation Settings
validation:
  check_services: true      # Check if vulnerable services are running
  check_versions: true      # Validate version ranges
  strict_mode: false        # If true, only mark CVE as applicable if all checks pass

# Report Settings  
report:
  include_non_applicable: true  # Include CVEs that don't apply to system
  include_mitigation: true      # Include mitigation steps in report
  
# CVE Fetching Settings
nvd:
  rate_limit_delay: 6  # Seconds between requests without API key
  max_cves_per_cpe: 5  # Maximum CVEs to fetch per CPE